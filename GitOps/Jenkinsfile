// CD pipeline: bump the image tag in the Kubernetes manifests and push.
// Argo CD watches the kubernetes/ directory and reconciles the cluster.
// This job never talks to the cluster directly; git is the only interface.

pipeline {
    agent { label 'jenkins-worker' }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Tag produced by the CI job (build-number-gitsha)')
    }

    environment {
        REPO_URL       = 'https://github.com/hammad558/End-to-End-DevOps-Pipeline.git'
        DOCKERHUB_USER = 'hammad558'
        NOTIFY_EMAIL   = 'hammadwaraich888@gmail.com'
        GIT_AUTHOR     = 'jenkins-ci'
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) { error('IMAGE_TAG is required') }
                }
            }
        }

        stage('Checkout') {
            steps {
                cleanWs()
                git url: env.REPO_URL, branch: 'main'
            }
        }

        stage('Update manifests') {
            steps {
                dir('kubernetes') {
                    sh """
                      sed -i -E 's#(${DOCKERHUB_USER}/wanderlust-backend):[^"[:space:]]+#\\1:${params.IMAGE_TAG}#'  backend.yaml
                      sed -i -E 's#(${DOCKERHUB_USER}/wanderlust-frontend):[^"[:space:]]+#\\1:${params.IMAGE_TAG}#' frontend.yaml
                      grep -n 'image:' backend.yaml frontend.yaml
                    """
                }
            }
        }

        stage('Commit and push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-cred',
                                                  usernameVariable: 'GH_USER',
                                                  passwordVariable: 'GH_TOKEN')]) {
                    sh '''
                      git config user.name  "${GIT_AUTHOR}"
                      git config user.email "${NOTIFY_EMAIL}"
                      git add kubernetes/backend.yaml kubernetes/frontend.yaml
                      if git diff --cached --quiet; then echo "No manifest change"; exit 0; fi
                      git commit -m "deploy: wanderlust ${IMAGE_TAG}"
                      git push "https://${GH_USER}:${GH_TOKEN}@github.com/hammad558/End-to-End-DevOps-Pipeline.git" HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            emailext to: env.NOTIFY_EMAIL,
                     subject: "[wanderlust] deployed ${params.IMAGE_TAG}",
                     body: "Manifests updated to ${params.IMAGE_TAG}. Argo CD will sync within its polling interval.\n\n${env.BUILD_URL}"
        }
        failure {
            emailext to: env.NOTIFY_EMAIL, attachLog: true,
                     subject: "[wanderlust] CD FAILED for ${params.IMAGE_TAG}",
                     body: "See attached log.\n\n${env.BUILD_URL}"
        }
    }
}

# DO NOT commit a real secret. Create it out-of-band, e.g.
#   kubectl -n wanderlust create secret generic wanderlust-secrets \
#     --from-literal=JWT_SECRET="$(openssl rand -hex 64)"
# or manage it with External Secrets Operator / Sealed Secrets.
apiVersion: v1
kind: Secret
metadata:
  name: wanderlust-secrets
  namespace: wanderlust
type: Opaque
stringData:
  JWT_SECRET: "replace-me"
